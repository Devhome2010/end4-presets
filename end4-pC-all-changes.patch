     }
 
+    // Enable/disable individual animation leaves (e.g. "windowsIn", "border",
+    // "layersIn") instead of the global animations:enabled master switch, so
+    // some categories (like layer-shell surfaces such as sidebars) can be
+    // left animated while others are turned off.
+    function setAnimLeaves(entries: var) {
+        let args = ["python3", root.configuratorScriptPath, "--file", root.shellOverridesPath]
+        for (let leaf in entries) {
+            args.push("--set-anim", leaf, String(entries[leaf]))
+        }
+        Quickshell.execDetached(args)
+    }
+
+    function resetAnimLeaves(leaves: list<string>) {
+        let args = ["python3", root.configuratorScriptPath, "--file", root.shellOverridesPath]
+        for (let i = 0; i < leaves.length; i++) {
+            args.push("--reset-anim", leaves[i])
+        }
+        Quickshell.execDetached(args)
