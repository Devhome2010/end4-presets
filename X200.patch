diff --git a/modules/ii/trayPanel/TrayPanel.qml b/modules/ii/trayPanel/TrayPanel.qml
new file mode 100644
index 0000000..1445039
--- /dev/null
+++ b/modules/ii/trayPanel/TrayPanel.qml
@@ -0,0 +1,341 @@
+pragma ComponentBehavior: Bound
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.functions
+import qs.modules.ii.bar
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Widgets
+import Quickshell.Services.SystemTray
+
+// Standalone tray panel, opened from the hot corner dropdown
+// (GlobalStates.trayPanelOpen). Shows every StatusNotifierItem as a big
+// Material-style tile: left click = activate, right click = context menu.
+// Same Loader-active pattern as EqualizerPopup, so the window only exists
+// while the panel is open.
+Scope {
+    id: root
+
+    readonly property var cfg: Config.options.trayPanel
+    readonly property int columns: cfg.columns
+    readonly property real tileSize: cfg.tileSize
+    readonly property real tileSpacing: 8
+    readonly property real cardPadding: 20
+    readonly property real cardRadius: cfg.cornerRadius
+    readonly property bool animate: cfg.animate
+    readonly property bool showLabels: cfg.showLabels
+    readonly property string placement: cfg.placement
+    readonly property var trayItems: cfg.hideInactive
+        ? SystemTray.items.values.filter(i => i.status !== Status.Passive)
+        : [...SystemTray.items.values]
+
+    readonly property bool barVertical: Config.options.bar.vertical
+    readonly property string barEdge: {
+        if (!barVertical) return Config.options.bar.bottom ? "bottom" : "top"
+        return Config.options.bar.bottom ? "right" : "left"
+    }
+    readonly property real barThickness: barVertical ? Appearance.sizes.verticalBarWidth : Appearance.sizes.barHeight
+    readonly property real gap: Appearance.sizes.hyprlandGapsOut
+
+    // Placement: "bar" hugs the bar side, otherwise a fixed screen corner / center
+    readonly property bool anchorTop: placement === "bar" ? barEdge !== "bottom" : placement.startsWith("top")
+    readonly property bool anchorBottom: placement === "bar" ? barEdge === "bottom" : placement.startsWith("bottom")
+    readonly property bool anchorRight: placement === "bar" ? barEdge !== "left" : placement.endsWith("Right")
+    readonly property bool anchorLeft: placement === "bar" ? barEdge === "left" : placement.endsWith("Left")
+
+    Loader {
+        id: panelLoader
+        active: GlobalStates.trayPanelOpen
+
+        sourceComponent: PanelWindow {
+            id: panelWindow
+            visible: true
+
+            exclusionMode: ExclusionMode.Ignore
+            exclusiveZone: 0
+            color: "transparent"
+            WlrLayershell.namespace: "quickshell:trayPanel"
+            WlrLayershell.layer: WlrLayer.Overlay
+
+            implicitWidth: card.implicitWidth + Appearance.sizes.elevationMargin * 2
+            implicitHeight: card.implicitHeight + Appearance.sizes.elevationMargin * 2
+
+            anchors {
+                top: root.anchorTop
+                bottom: root.anchorBottom
+                right: root.anchorRight
+                left: root.anchorLeft
+            }
+            margins {
+                top: root.anchorTop ? root.gap + (root.barEdge === "top" ? root.barThickness : 0) : 0
+                bottom: root.anchorBottom ? root.gap + (root.barEdge === "bottom" ? root.barThickness : 0) : 0
+                right: root.anchorRight ? root.gap + (root.barEdge === "right" ? root.barThickness : 0) : 0
+                left: root.anchorLeft ? root.gap + (root.barEdge === "left" ? root.barThickness : 0) : 0
+            }
+
+            mask: Region { item: card }
+
+            Component.onCompleted: GlobalFocusGrab.addDismissable(panelWindow)
+            Component.onDestruction: GlobalFocusGrab.removeDismissable(panelWindow)
+            Connections {
+                target: GlobalFocusGrab
+                function onDismissed() { GlobalStates.trayPanelOpen = false }
+            }
+
+            StyledRectangularShadow { target: card }
+
+            Rectangle {
+                id: card
+                anchors.centerIn: parent
+
+                property bool shown: !root.animate
+                Component.onCompleted: shown = true
+
+                implicitWidth: content.implicitWidth + root.cardPadding * 2
+                implicitHeight: content.implicitHeight + root.cardPadding * 2
+                radius: root.cardRadius
+                color: Appearance.colors.colLayer0
+                border.width: 1
+                border.color: Appearance.colors.colLayer0Border
+
+                // Springy entrance (M3 expressive fast spatial overshoot)
+                transformOrigin: {
+                    if (root.anchorTop && root.anchorRight) return Item.TopRight
+                    if (root.anchorTop && root.anchorLeft) return Item.TopLeft
+                    if (root.anchorBottom && root.anchorRight) return Item.BottomRight
+                    if (root.anchorBottom && root.anchorLeft) return Item.BottomLeft
+                    return Item.Center
+                }
+                opacity: shown ? 1 : 0
+                scale: shown ? 1 : 0.8
+                Behavior on opacity {
+                    enabled: root.animate
+                    NumberAnimation {
+                        duration: Appearance.animationCurves.expressiveEffectsDuration
+                        easing.type: Easing.BezierSpline
+                        easing.bezierCurve: Appearance.animationCurves.expressiveEffects
+                    }
+                }
+                Behavior on scale {
+                    enabled: root.animate
+                    NumberAnimation {
+                        duration: 450
+                        easing.type: Easing.BezierSpline
+                        easing.bezierCurve: Appearance.animationCurves.expressiveFastSpatial
+                    }
+                }
+                Behavior on implicitHeight {
+                    enabled: root.animate
+                    NumberAnimation {
+                        duration: 350
+                        easing.type: Easing.BezierSpline
+                        easing.bezierCurve: Appearance.animationCurves.expressiveFastSpatial
+                    }
+                }
+
+                ColumnLayout {
+                    id: content
+                    anchors.centerIn: parent
+                    spacing: 14
+
+                    // Header
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: 10
+
+                        Rectangle {
+                            implicitWidth: 40
+                            implicitHeight: 40
+                            radius: Appearance.rounding.full
+                            color: Appearance.colors.colSecondaryContainer
+                            MaterialSymbol {
+                                anchors.centerIn: parent
+                                text: "widgets"
+                                iconSize: 22
+                                color: Appearance.colors.colOnSecondaryContainer
+                            }
+                        }
+                        StyledText {
+                            Layout.fillWidth: true
+                            text: Translation.tr("System tray")
+                            font.pixelSize: Appearance.font.pixelSize.larger
+                            color: Appearance.colors.colOnLayer0
+                        }
+                        Rectangle {
+                            implicitWidth: countText.implicitWidth + 20
+                            implicitHeight: 28
+                            radius: Appearance.rounding.full
+                            color: Appearance.colors.colLayer1
+                            StyledText {
+                                id: countText
+                                anchors.centerIn: parent
+                                text: root.trayItems.length
+                                font.pixelSize: Appearance.font.pixelSize.smaller
+                                color: Appearance.colors.colOnLayer1
+                            }
+                        }
+                    }
+
+                    // Tiles
+                    GridLayout {
+                        id: grid
+                        Layout.alignment: Qt.AlignHCenter
+                        visible: root.trayItems.length > 0
+                        columns: root.columns
+                        columnSpacing: root.tileSpacing
+                        rowSpacing: root.tileSpacing
+
+                        Repeater {
+                            model: ScriptModel { values: root.trayItems }
+                            delegate: TrayTile {}
+                        }
+                    }
+
+                    // Empty state
+                    ColumnLayout {
+                        Layout.alignment: Qt.AlignHCenter
+                        Layout.preferredWidth: root.columns * root.tileSize + (root.columns - 1) * root.tileSpacing
+                        Layout.topMargin: 12
+                        Layout.bottomMargin: 12
+                        visible: root.trayItems.length === 0
+                        spacing: 8
+                        MaterialSymbol {
+                            Layout.alignment: Qt.AlignHCenter
+                            text: "inbox"
+                            iconSize: 40
+                            color: Appearance.colors.colSubtext
+                        }
+                        StyledText {
+                            Layout.alignment: Qt.AlignHCenter
+                            text: Translation.tr("No apps in the tray")
+                            color: Appearance.colors.colSubtext
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    component TrayTile: MouseArea {
+        id: tile
+        required property var modelData
+        required property int index
+        readonly property var trayItem: modelData
+
+        property bool shown: !root.animate
+        property var menuWindow: null
+
+        Layout.preferredWidth: root.tileSize
+        Layout.preferredHeight: root.tileSize
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        cursorShape: Qt.PointingHandCursor
+
+        // Staggered pop-in
+        Timer {
+            running: root.animate
+            interval: 40 + tile.index * 35
+            onTriggered: tile.shown = true
+        }
+        opacity: shown ? 1 : 0
+        scale: shown ? (tile.pressed ? 0.93 : 1) : 0.7
+        Behavior on opacity {
+            enabled: root.animate
+            animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
+        }
+        Behavior on scale {
+            enabled: root.animate
+            NumberAnimation {
+                duration: 350
+                easing.type: Easing.BezierSpline
+                easing.bezierCurve: Appearance.animationCurves.expressiveFastSpatial
+            }
+        }
+
+        function openMenu() {
+            if (!trayItem.hasMenu) return;
+            if (menuLoader.active && menuLoader.item && typeof menuLoader.item.close === "function")
+                menuLoader.item.close();
+            else
+                menuLoader.active = true;
+        }
+
+        onClicked: event => {
+            if (event.button === Qt.RightButton) {
+                tile.openMenu();
+            } else if (trayItem.onlyMenu) {
+                tile.openMenu();
+            } else {
+                trayItem.activate();
+            }
+        }
+
+        Loader {
+            id: menuLoader
+            active: false
+            sourceComponent: SysTrayMenu {
+                Component.onCompleted: this.open()
+                trayItemMenuHandle: tile.trayItem.menu
+                trayItemId: tile.trayItem.id
+                anchor {
+                    window: tile.QsWindow.window
+                    item: tile
+                    gravity: Edges.Bottom
+                    edges: Edges.Bottom
+                }
+                onMenuOpened: window => {
+                    tile.menuWindow = window;
+                    GlobalFocusGrab.addPersistent(window);
+                }
+                onMenuClosed: {
+                    if (tile.menuWindow) GlobalFocusGrab.removePersistent(tile.menuWindow);
+                    tile.menuWindow = null;
+                    menuLoader.active = false;
+                }
+            }
+        }
+
+        // Shape-morphing background: squircle -> rounder on hover
+        Rectangle {
+            id: bg
+            anchors.fill: parent
+            radius: Math.min(tile.width / 2, tile.containsMouse && root.animate ? root.cardRadius + 6 : root.cardRadius - 5)
+            color: tile.containsMouse ? Appearance.colors.colSecondaryContainer : Appearance.colors.colLayer1
+            Behavior on radius {
+                enabled: root.animate
+                NumberAnimation {
+                    duration: 300
+                    easing.type: Easing.BezierSpline
+                    easing.bezierCurve: Appearance.animationCurves.expressiveFastSpatial
+                }
+            }
+            Behavior on color { animation: Appearance.animation.elementMoveFast.colorAnimation.createObject(this) }
+        }
+
+        ColumnLayout {
+            anchors.centerIn: parent
+            width: parent.width - 12
+            spacing: 6
+
+            IconImage {
+                Layout.alignment: Qt.AlignHCenter
+                implicitSize: Math.round(root.tileSize * 0.42)
+                source: tile.trayItem.icon
+            }
+            StyledText {
+                Layout.fillWidth: true
+                visible: root.showLabels
+                horizontalAlignment: Text.AlignHCenter
+                elide: Text.ElideRight
+                text: tile.trayItem.tooltipTitle.length > 0 ? tile.trayItem.tooltipTitle
+                    : (tile.trayItem.title.length > 0 ? tile.trayItem.title : tile.trayItem.id)
+                font.pixelSize: Appearance.font.pixelSize.smaller
+                color: tile.containsMouse ? Appearance.colors.colOnSecondaryContainer : Appearance.colors.colOnLayer1
+            }
+        }
+    }
+}
