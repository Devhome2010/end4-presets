diff --git a/modules/ii/cheatsheet/Cheatsheet.qml b/modules/ii/cheatsheet/Cheatsheet.qml
new file mode 100644
index 0000000..79b2380
--- /dev/null
+++ b/modules/ii/cheatsheet/Cheatsheet.qml
@@ -0,0 +1,223 @@
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Qt.labs.synchronizer
+import Qt5Compat.GraphicalEffects
+import Quickshell.Io
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Hyprland
+
+Scope { // Scope
+    id: root
+    property var tabButtonList: [
+        {
+            "icon": "keyboard",
+            "name": Translation.tr("Keybinds")
+        },
+        {
+            "icon": "experiment",
+            "name": Translation.tr("Elements")
+        },
+    ]
+
+    Loader {
+        id: cheatsheetLoader
+        active: false
+
+        sourceComponent: PanelWindow { // Window
+            id: cheatsheetRoot
+            visible: cheatsheetLoader.active
+
+            anchors {
+                top: true
+                bottom: true
+                left: true
+                right: true
+            }
+
+            function hide() {
+                cheatsheetLoader.active = false;
+            }
+            exclusiveZone: 0
+            implicitWidth: cheatsheetBackground.width + Appearance.sizes.elevationMargin * 2
+            implicitHeight: cheatsheetBackground.height + Appearance.sizes.elevationMargin * 2
+            WlrLayershell.namespace: "quickshell:cheatsheet"
+            // Setting this value makes it take its sweet time to open
+            // WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
+            color: "transparent"
+
+            mask: Region {
+                item: cheatsheetBackground
+            }
+
+            Component.onCompleted: {
+                GlobalFocusGrab.addDismissable(cheatsheetRoot);
+            }
+            Component.onDestruction: {
+                GlobalFocusGrab.removeDismissable(cheatsheetRoot);
+            }
+            Connections {
+                target: GlobalFocusGrab
+                function onDismissed() {
+                    cheatsheetRoot.hide();
+                }
+            }
+
+            // Background
+            StyledRectangularShadow {
+                target: cheatsheetBackground
+            }
+            Rectangle {
+                id: cheatsheetBackground
+                anchors.centerIn: parent
+                color: Appearance.colors.colLayer0
+                border.width: 1
+                border.color: Appearance.colors.colLayer0Border
+                radius: Appearance.rounding.windowRounding
+                property real padding: 20
+                implicitWidth: cheatsheetColumnLayout.implicitWidth + padding * 2
+                implicitHeight: cheatsheetColumnLayout.implicitHeight + padding * 2
+
+                Keys.onPressed: event => { // Esc to close
+                    if (event.key === Qt.Key_Escape) {
+                        cheatsheetRoot.hide();
+                    }
+                    if (event.modifiers === Qt.ControlModifier) {
+                        if (event.key === Qt.Key_PageDown) {
+                            tabBar.incrementCurrentIndex();
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_PageUp) {
+                            tabBar.decrementCurrentIndex();
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_Tab) {
+                            tabBar.setCurrentIndex((tabBar.currentIndex + 1) % root.tabButtonList.length);
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_Backtab) {
+                            tabBar.setCurrentIndex((tabBar.currentIndex - 1 + root.tabButtonList.length) % root.tabButtonList.length);
+                            event.accepted = true;
+                        }
+                    }
+                }
+
+                RippleButton { // Close button
+                    id: closeButton
+                    focus: cheatsheetRoot.visible
+                    implicitWidth: 40
+                    implicitHeight: 40
+                    buttonRadius: Appearance.rounding.full
+                    anchors {
+                        top: parent.top
+                        right: parent.right
+                        topMargin: 20
+                        rightMargin: 20
+                    }
+
+                    onClicked: {
+                        cheatsheetRoot.hide();
+                    }
+
+                    contentItem: MaterialSymbol {
+                        anchors.centerIn: parent
+                        horizontalAlignment: Text.AlignHCenter
+                        font.pixelSize: Appearance.font.pixelSize.title
+                        text: "close"
+                    }
+                }
+
+                ColumnLayout { // Real content
+                    id: cheatsheetColumnLayout
+                    anchors.centerIn: parent
+                    spacing: 10
+
+                    Toolbar {
+                        Layout.alignment: Qt.AlignHCenter
+                        enableShadow: false
+                        ToolbarTabBar {
+                            id: tabBar
+                            tabButtonList: root.tabButtonList
+
+                            Synchronizer on currentIndex {
+                                property alias source: swipeView.currentIndex
+                            }
+                        }
+                    }
+
+                    SwipeView { // Content pages
+                        id: swipeView
+                        Layout.topMargin: 5
+                        Layout.fillWidth: true
+                        Layout.fillHeight: true
+                        spacing: 10
+                        currentIndex: Persistent.states.cheatsheet.tabIndex
+                        onCurrentIndexChanged: {
+                            Persistent.states.cheatsheet.tabIndex = currentIndex;
+                        }
+
+                        implicitWidth: Math.max.apply(null, contentChildren.map(child => child.implicitWidth || 0))
+                        implicitHeight: Math.max.apply(null, contentChildren.map(child => child.implicitHeight || 0))
+
+                        clip: true
+                        layer.enabled: true
+                        layer.effect: OpacityMask {
+                            maskSource: Rectangle {
+                                width: swipeView.width
+                                height: swipeView.height
+                                radius: Appearance.rounding.small
+                            }
+                        }
+
+                        CheatsheetKeybinds {}
+                        CheatsheetPeriodicTable {}
+                    }
+                }
+            }
+        }
+    }
+
+    IpcHandler {
+        target: "cheatsheet"
+
+        function toggle(): void {
+            cheatsheetLoader.active = !cheatsheetLoader.active;
+        }
+
+        function close(): void {
+            cheatsheetLoader.active = false;
+        }
+
+        function open(): void {
+            cheatsheetLoader.active = true;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetToggle"
+        description: "Toggles cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = !cheatsheetLoader.active;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetOpen"
+        description: "Opens cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = true;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetClose"
+        description: "Closes cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = false;
+        }
+    }
+}
diff --git a/modules/ii/cheatsheet/CheatsheetKeybinds.qml b/modules/ii/cheatsheet/CheatsheetKeybinds.qml
new file mode 100644
index 0000000..e4bccb7
--- /dev/null
+++ b/modules/ii/cheatsheet/CheatsheetKeybinds.qml
@@ -0,0 +1,47 @@
+pragma ComponentBehavior: Bound
+
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+
+// Adapted for end4-pC's tree-based HyprlandKeybinds service
+// (upstream illogical-impulse used a flat `keybindCategories` list;
+// end4-pC exposes `HyprlandKeybinds.keybinds.children`, a tree of
+// {children, keybinds, name} sections instead)
+Item {
+    id: root
+    property real padding: 4
+    implicitWidth: QsWindow?.window?.screen.width * 0.7 ?? 0
+    implicitHeight: QsWindow?.window?.screen.height * 0.7 ?? 0
+
+    StyledFlickable {
+        id: flickable
+        clip: true
+        anchors.fill: parent
+        anchors.margins: Appearance.rounding.small
+        contentHeight: height
+        contentWidth: flow.implicitWidth
+        Flow {
+            id: flow
+            height: flickable.height
+            flow: Flow.TopToBottom
+            spacing: 10
+            Repeater {
+                model: HyprlandKeybinds.keybinds.children ?? []
+                delegate: CheatsheetKeybindsCategory {
+                    required property var modelData
+                    section: modelData
+                }
+            }
+        }
+    }
+
+    ScrollEdgeFade {
+        target: flickable
+        vertical: false
+        color: Appearance.colors.colLayer0Base
+    }
+}
diff --git a/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml b/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml
new file mode 100644
index 0000000..b54fd60
--- /dev/null
+++ b/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml
@@ -0,0 +1,127 @@
+pragma ComponentBehavior: Bound
+
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+
+// Adapted for end4-pC's tree-based HyprlandKeybinds service.
+// `section` is one node from HyprlandKeybinds.keybinds.children:
+//   { children: [Section...], keybinds: [KeyBinding...], name: string }
+// where KeyBinding = { mods: [string], key: string, dispatcher, params, comment }
+// (end4-pC's parser already gives us human-readable mod names, e.g.
+// "SUPER", "SHIFT", so there's no bitmask to decode like upstream had to)
+Column {
+    id: root
+    required property var section
+    property real columnSpacing: 40
+    property real titleSpacing: 7
+
+    // Cosmetic renames only; extend as you like
+    property var keySubstitutions: ({
+        "SUPER": "Super",
+        "Slash": "/",
+        "Hash": "#",
+        "Return": "Enter",
+        "mouse:272": "LMB",
+        "mouse:273": "RMB",
+        "mouse:275": "MouseBack",
+    })
+
+    function hasComment(bind) {
+        return !!bind.comment && bind.comment.length > 0;
+    }
+
+    // Loop-generated binds (workspace 1-10, resize left/right/up/down, etc.)
+    // repeat the same comment N times - keep only the "first" of each group
+    function containsNonFirstRepetitive(bind) {
+        const key = bind.key || "";
+        if (key.toLowerCase().includes("mouse")) return false;
+        if (/\d/.test(key) && !key.includes("1")) return true;
+        if (/^(right|up|down)\b/i.test(key)) return true;
+        return false;
+    }
+
+    function transformKey(key) {
+        const replaced = root.keySubstitutions[key] || key;
+        const denumbered = replaced.replace("1", "<Number>");
+        const dedirectioned = denumbered.replace(/^left$/i, "<Direction>");
+        return dedirectioned;
+    }
+
+    function transformMod(mod) {
+        return root.keySubstitutions[mod] || mod;
+    }
+
+    // Recursively gather every keybind under this section (including
+    // nested subsections) so one category header covers its whole tree
+    function collectBinds(node) {
+        let result = (node.keybinds ?? []).filter(b => root.hasComment(b) && !root.containsNonFirstRepetitive(b));
+        for (const child of (node.children ?? [])) {
+            result = result.concat(root.collectBinds(child));
+        }
+        return result;
+    }
+
+    property var binds: root.collectBinds(root.section)
+
+    visible: binds.length > 0
+    spacing: titleSpacing
+
+    StyledText {
+        text: (root.section.name?.length > 0) ? root.section.name : qsTr("Uncategorized")
+        font.pixelSize: Appearance.font.pixelSize.title
+    }
+
+    Column {
+        spacing: 4
+        Repeater {
+            model: root.binds
+            delegate: BindLine {
+                required property var modelData
+                keyData: modelData
+            }
+        }
+    }
+
+    component BindLine: Row {
+        id: bindLine
+        required property var keyData
+
+        Row {
+            spacing: 16
+            Row {
+                spacing: 4
+                Repeater {
+                    model: (bindLine.keyData.mods ?? []).map(m => root.transformMod(m))
+                    delegate: KeyboardKey {
+                        required property var modelData
+                        key: modelData
+                    }
+                }
+                StyledText {
+                    anchors.verticalCenter: parent.verticalCenter
+                    visible: (bindLine.keyData.mods ?? []).length > 0
+                    text: "+"
+                }
+                KeyboardKey {
+                    anchors.verticalCenter: parent.verticalCenter
+                    key: root.transformKey(bindLine.keyData.key)
+                }
+            }
+            Item {
+                anchors.verticalCenter: parent.verticalCenter
+                implicitWidth: commentText.implicitWidth + root.columnSpacing
+                implicitHeight: commentText.implicitHeight
+                StyledText {
+                    id: commentText
+                    anchors.verticalCenter: parent.verticalCenter
+                    anchors.left: parent.left
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    text: bindLine.keyData.comment
+                }
+            }
+        }
+    }
+}
