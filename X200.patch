+def to_lua_animation_line(leaf, enabled):
+    val = "false" if str(enabled) in ("0", "false", "False") else "true"
+    return f'hl.animation({{ leaf = "{leaf}", enabled = {val} }})\n'
+
+
+def make_animation_marker(leaf):
+    return f'leaf = "{leaf}"'
+
+
+def edit_lua_animations(file_path, set_pairs, reset_leaves):
+    try:
+        with open(file_path) as f:
+            lines = f.readlines()
+    except FileNotFoundError:
+        lines = []
+
+    set_dict    = dict(set_pairs)
+    reset_set   = set(reset_leaves)
+    all_leaves  = list(set_dict) + list(reset_set)
+    markers     = {leaf: make_animation_marker(leaf) for leaf in all_leaves}
+
+    new_lines  = []
+    found_leaves = set()
+
+    for line in lines:
+        matched = None
+        for leaf in all_leaves:
+            if markers[leaf] in line:
+                matched = leaf
+                break
+        if matched is None:
+            new_lines.append(line)
+        elif matched in reset_set:
+            print(f"Removed animation override: {matched}")
+        else:
+            new_lines.append(to_lua_animation_line(matched, set_dict[matched]))
+            found_leaves.add(matched)
+            print(f"Updated animation: {to_lua_animation_line(matched, set_dict[matched]).strip()}")
+
+    for leaf, enabled in set_dict.items():
+        if leaf not in found_leaves:
+            new_lines.append(to_lua_animation_line(leaf, enabled))
+            print(f"Added animation:   {to_lua_animation_line(leaf, enabled).strip()}")
+
+    write_atomic(file_path, "".join(new_lines))
+
+
